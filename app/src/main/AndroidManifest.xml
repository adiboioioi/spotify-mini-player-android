<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required on Android 11+ (API 30+) so this app is allowed to see/bind
         to the Spotify app's remote service; without this, App Remote fails
         with SpotifyRemoteServiceException even when Spotify is installed. -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="Spotify Mini Player"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Spotify's login redirect intent-filter is contributed automatically
                 by the Auth SDK's manifest via the manifestPlaceholders set in
                 app/build.gradle.kts (redirectSchemeName / redirectHostName) -->
        </activity>
    </application>
</manifest>
